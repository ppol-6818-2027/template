// The deck format for the pair project's weekly slides (deck.qmd), rendered
// to a PDF through Typst. It follows Georgetown's visual identity as the
// university posts it (georgetown.edu/visual-identity and /color-guide, read
// 2026-11-18): Georgetown Blue and Georgetown Gray as the primary colors,
// the secondary palette for links and rules; Caslon for titles and Futura
// for text, here their open equivalents Libre Caslon Text and Jost (SIL Open
// Font License, in fonts/), since Adobe Caslon and Futura are licensed. No
// logo or seal: the university approves each use of those. Each level 2
// heading (##) starts a slide; a level 1 heading (#) is a section slide.
// Students do not edit this file; they write in deck.qmd.

#let gu-blue = rgb("#041E42")   // Georgetown Blue, Pantone 282
#let gu-gray = rgb("#63666A")   // Georgetown Gray, Cool Gray 10
#let gu-link = rgb("#003DA5")   // Pantone 293
#let gu-rule = rgb("#BBBCBC")   // Cool Gray 4
#let gu-stone = rgb("#D6D2C4")  // Pantone 7527
#let ink = rgb("#1F2328")
#let serif = "Libre Caslon Text"
#let sans = "Jost"

#let deck(title: none, subtitle: none, authors: (), date: none,
  course: [PPOL 6818 #h(0.5em)·#h(0.5em) McCourt School of Public Policy #h(0.5em)·#h(0.5em) Georgetown University],
  body) = {
  set document(title: title)
  set text(font: sans, size: 19pt, fill: ink, lang: "en", region: "us")
  set par(leading: 0.6em, spacing: 0.9em, justify: false)
  show link: set text(fill: gu-link)
  set list(marker: text(fill: gu-gray, size: 0.8em, baseline: -0.1em, [■]), indent: 0.3em, body-indent: 0.6em)
  set enum(indent: 0.3em, body-indent: 0.6em)
  show raw: set text(size: 0.85em)
  show strong: set text(weight: 600)

  set page(paper: "presentation-16-9", margin: (x: 1.5cm, top: 1.6cm, bottom: 1.5cm),
    background: place(top, rect(width: 100%, height: 0.32cm, fill: gu-blue)),
    footer: context {
      set text(size: 10pt, fill: gu-gray)
      course
      h(1fr)
      counter(page).display()
    })

  // A slide's title: Caslon in Georgetown Blue over a short stone rule.
  show heading.where(level: 2): it => {
    pagebreak(weak: true)
    block(below: 0.7em, {
      text(font: serif, size: 28pt, fill: gu-blue, weight: "regular", it.body)
      v(0.25em)
      line(length: 2.5cm, stroke: 2pt + gu-stone)
    })
  }
  // A section slide: the whole page in Georgetown Blue.
  show heading.where(level: 1): it => {
    page(fill: gu-blue, background: none, footer: none, align(horizon,
      text(font: serif, size: 36pt, weight: "regular", fill: white, it.body)))
  }
  show heading.where(level: 3): set text(font: sans, size: 20pt, weight: 600, fill: gu-blue)

  // An exhibit beside its words (layout="[50,50]" in deck.qmd): the words
  // a size smaller, so a hundred of them fit beside the exhibit.
  show grid: set text(size: 15pt)
  show grid: set par(leading: 0.55em)
  show figure: set align(center)
  show figure.caption: set text(size: 13pt, fill: gu-gray)
  show table: set text(size: 14pt)
  set table(stroke: (x, y) => if y == 0 { (bottom: 0.8pt + gu-blue) }, inset: (x: 0.5em, y: 0.35em))

  // The title slide.
  page(fill: gu-blue, background: none, footer: none, {
    set text(fill: white)
    v(1fr)
    text(font: serif, size: 38pt, title)
    if subtitle != none { v(0.3em); text(size: 22pt, fill: gu-stone, subtitle) }
    if authors.len() > 0 { v(0.6em); text(size: 18pt, authors.join(", ", last: " and ")) }
    if date != none { v(0.3em); text(size: 15pt, fill: gu-rule, date) }
    v(1fr)
    line(length: 100%, stroke: 0.6pt + gu-gray)
    v(0.2em)
    text(size: 11pt, fill: gu-rule, course)
  })

  body
}
